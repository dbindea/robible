{
  "name": "robible-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RoBible API — auth, topics, favorites (Cloudflare Workers + D1)",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --experimental-sqlite dev-server.js",
    "start": "node --experimental-sqlite dev-server.js",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute robible-db --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute robible-db --file=schema.sql",
    "db:create": "wrangler d1 create robible-db"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.7"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
