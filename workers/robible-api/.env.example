# ── Configuración local del dev server ──
# Copia este archivo a .env y rellena los valores

# Puerto del dev server
PORT=8787

# Ruta de la DB SQLite local
DB_PATH=./.dev-data/robible.db

# Secret para firmar los JWT (HMAC-SHA256). CAMBIA ESTO EN PRODUCCIÓN.
# Genera uno con: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-in-production-please-make-it-long

# Orígenes CORS permitidos (CSV)
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Rate limits
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=500
