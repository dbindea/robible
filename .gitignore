# Dependencies
node_modules/

# Build output
public/build/
dist/

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Keep .env.example checked in (negation must come after the pattern)
/!.env.example

# Backend dev data
workers/*/.dev-data/
workers/*/.wrangler/

# Dev server logs (regenerated on every `npm run dev`)
dev.log
*.log

# Capturas y trazas que deja el MCP de Playwright al verificar en el navegador
.playwright-mcp/

# Salida del pipeline de logo (scripts/build-logo.js). Los iconos que usa la app
# viven en public/. Estos son intermedios y pesan ~16 MB.
# Sacados del índice el 8 sep 2026 con `git rm -r --cached robible/`. Los
# ficheros siguen en disco; en un clon nuevo hay que regenerarlos con
# `node scripts/build-logo.js` antes de usar `scripts/resize-logo.js`.
# El histórico los conserva: recuperar el tamaño del repo exigiría reescribirlo.
robible/

